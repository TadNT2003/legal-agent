# Copy this file to .env and fill in real values before running `npm run start:dev`.
# Do not commit the real .env file.
#
# This server is deliberately separate from ../server (the scraper/ingestion
# app) and ../agent-bot (the Discord PoC agent) — it never touches Postgres
# directly, only the scraper server's existing HTTP retrieve API. Make sure
# ../server is running before starting this one.

# Must differ from ../server's PORT (3000 by default) and ../agent-bot's
# PORT (3100 by default) — all three may run locally at the same time.
PORT=3200

# --- Scraper server (../server) HTTP API ---
# Base URL of the running scraper server, whose /laws/index/retrieve/* routes
# are this MCP server's only source of legal document data. Read
# ../server/.env's own PORT rather than assuming 3000 if you're not sure.
LAW_API_BASE_URL=http://localhost:3000

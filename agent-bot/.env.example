# Copy this file to .env and fill in real values before running `npm run start:dev`.
# Do not commit the real .env file.
#
# This server is deliberately separate from ../server (the scraper/ingestion
# app) — it never touches Postgres directly, only the scraper server's
# existing HTTP retrieve API. Make sure ../server is running before starting
# this one.

# Must differ from ../server's PORT (3000 by default) — both run locally at
# the same time.
PORT=3100

# --- Scraper server (../server) HTTP API ---
# Base URL of the running scraper server, whose /laws/index/retrieve/* routes
# are this agent's only source of legal document data. Read ../server/.env's
# own PORT rather than assuming 3000 if you're not sure it's still default.
LAW_API_BASE_URL=http://localhost:3000

# --- LLM (OpenAI-compatible endpoint) ---
# Self-hosted inference server (vLLM/Ollama/LM Studio) exposing an
# OpenAI-compatible /v1/chat/completions API. Tool-calling support depends on
# the specific server/model — verify with a smoke test before relying on it
# (vLLM needs --enable-auto-tool-choice + a matching --tool-call-parser).
OPENAI_BASE_URL=http://localhost:11434/v1
# Many self-hosted servers ignore the key but the SDK requires a non-empty
# string.
OPENAI_API_KEY=not-needed
# Exact model name as served by OPENAI_BASE_URL — no universal default.
OPENAI_MODEL=llama3.1

# --- Discord bot ---
# From the Discord Developer Portal (Bot tab). The bot's MessageContent
# privileged intent must be enabled there for mention/DM text to be readable.
DISCORD_BOT_TOKEN=

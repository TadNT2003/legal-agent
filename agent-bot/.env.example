# Copy this file to .env and fill in real values before running `npm run start:dev`.
# Do not commit the real .env file.
#
# This server is deliberately separate from ../server (the scraper/ingestion
# app) and ../legal-mcp (the retrieval harness) — it never touches Postgres
# or ../server directly, only ../legal-mcp's MCP tools. Make sure
# ../legal-mcp is running (which in turn needs ../server running) before
# starting this one.

# Must differ from ../server's PORT (3000 by default) and ../legal-mcp's
# PORT (3200 by default) — all three may run locally at the same time.
PORT=3100

# --- legal-mcp (../legal-mcp) MCP server ---
# Full endpoint URL (not just a base URL) of the running legal-mcp server —
# this agent has no tool logic of its own, it fetches its tool list and the
# legal_lookup_guidance prompt from here at startup. Read ../legal-mcp/.env's
# own PORT rather than assuming 3200 if you're not sure it's still default.
MCP_SERVER_URL=http://localhost:3200/mcp

# --- LLM (OpenAI-compatible endpoint) ---
# Self-hosted inference server (vLLM/Ollama/LM Studio) exposing an
# OpenAI-compatible /v1/chat/completions API. Tool-calling support depends on
# the specific server/model — verify with a smoke test before relying on it
# (vLLM needs --enable-auto-tool-choice + a matching --tool-call-parser).
OPENAI_BASE_URL=http://localhost:11434/v1
# Many self-hosted servers ignore the key but the SDK requires a non-empty
# string.
OPENAI_API_KEY=not-needed
# Exact model name as served by OPENAI_BASE_URL — no universal default.
OPENAI_MODEL=llama3.1

# --- Discord bot ---
# From the Discord Developer Portal (Bot tab). The bot's MessageContent
# privileged intent must be enabled there for mention/DM text to be readable.
DISCORD_BOT_TOKEN=

# Copy this file to .env and fill in real values before running `npm run start:dev`.
# Do not commit the real .env file.
#
# Postgres/OpenSearch/Neo4j credentials here must match the values used in the
# repo-root docker-compose.yml / .env (see ../.env.example) — this file just
# repeats them in the shape the Nest app's ConfigModule expects.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Postgres (source of truth, see ../DATABASE_DESIGN.md) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=legal_agent
POSTGRES_PASSWORD=ChangeMe_Str0ng!3
POSTGRES_DB=legal_agent

# --- OpenSearch ---
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=ChangeMe_Str0ng!1
# The compose cluster uses a self-signed cert — set to false for local dev
# only; production should verify a real cert (secure by default in code).
OPENSEARCH_REJECT_UNAUTHORIZED=false
OPENSEARCH_REQUEST_TIMEOUT_MS=30000

# --- OpenSearch projector (vbpl.vn document_node -> BM25 index, see
# src/law-index/opensearch/ — not wired into the app yet) ---
OPENSEARCH_PROJECTOR_INDEX_BASE_NAME=legal_provisions
OPENSEARCH_PROJECTOR_INDEX_VERSION=1
OPENSEARCH_PROJECTOR_READ_ALIAS=legal-provisions-read
OPENSEARCH_PROJECTOR_WRITE_ALIAS=legal-provisions-write
# Bulk buffer flushes at whichever of these is hit first.
OPENSEARCH_PROJECTOR_BULK_MAX_DOCS=500
OPENSEARCH_PROJECTOR_BULK_MAX_BYTES=5242880
# Single-node cluster: 1 replica would leave the index permanently yellow.
OPENSEARCH_PROJECTOR_NUMBER_OF_SHARDS=1
OPENSEARCH_PROJECTOR_NUMBER_OF_REPLICAS=0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ChangeMe_Str0ng!2

# --- ChromaDB ---
CHROMADB_URL=http://localhost:8000

# --- Law document downloads ---
# Resolved relative to the server's cwd. Default lands on the repo-root
# laws/ directory (see ../laws/README.md).
LAWS_DOWNLOAD_DIR=../laws

# --- Law index (vbpl.vn -> Postgres ingestion, see src/law-index/) ---
VBPL_BASE_URL=https://vbpl.vn
# Điều 4, Luật 64/2025/QH15 tier ceiling — 9 = trung ương only (see
# src/law-index/law-index.config.ts for why).
LAW_INDEX_MAX_TIER=9
# Minimum delay (ms) between page loads against vbpl.vn — a real government
# server, not a CDN.
LAW_INDEX_REQUEST_DELAY_MS=1000
# Set to false to run the underlying Chromium with a visible window (useful
# for debugging selector changes) instead of headless.
LAW_INDEX_HEADLESS=true
# How many documents to fetch before recycling the Chromium process to bound
# its memory. Set to 0 to disable (not recommended for batches >100).
LAW_INDEX_BROWSER_RECYCLE_INTERVAL=20

# --- Redis (job queue backing store for POST /crawl/all|batch|search, see
# src/law-index/job-queue/) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

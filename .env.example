# Copy this file to .env and set your own values before running `docker compose up`.
# Do not commit the real .env file.

# OpenSearch admin password.
# Required by OpenSearch >= 2.12. Must be >= 8 chars and include upper, lower,
# digit, and special character, or the container will fail to start.
OPENSEARCH_ADMIN_PASSWORD=ChangeMe_Str0ng!1

# Neo4j password for the default `neo4j` user. Must be >= 8 characters.
NEO4J_PASSWORD=ChangeMe_Str0ng!2

# Postgres password for the `legal_agent` user (source-of-truth database).
POSTGRES_PASSWORD=ChangeMe_Str0ng!3
